# Copie para .env e preencha os valores reais (nunca comite o .env de verdade)

# String de conexão Postgres (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Chave simples para proteger a listagem de agendamentos (GET /api/appointments)
ADMIN_API_KEY="defina-uma-chave-forte-aqui"

# Domínio de produção (usado em robots.txt, sitemap.xml e metadados Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.seudominio.com.br"

# E-mail de notificação (opcional) — via Resend (resend.com, tem plano gratuito)
# Sem isso definido, o site funciona normal, só não manda e-mail de aviso.
RESEND_API_KEY=""
# Para onde o aviso de novo pedido é enviado (padrão: e-mail do escritório em lib/site-data.ts).
# Pode ser um @gmail.com normal — não precisa verificar domínio para RECEBER.
NOTIFY_EMAIL_TO=""
# Remetente do e-mail. "onboarding@resend.dev" funciona sem verificar
# domínio nenhum; só troque se um dia verificar um domínio próprio no Resend.
RESEND_FROM=""
